{
  "name": "paper-trading-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint --no-cache",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "typecheck": "next typegen && tsc --noEmit",
