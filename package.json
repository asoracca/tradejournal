    "test:integration": "vitest run tests/integration.test.ts",
    "test:e2e": "playwright test",
    "db:local": "node scripts/local-db.mjs",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:grant-demo": "tsx scripts/grant-demo.ts",
    "test:migrations": "tsx scripts/test-migrations.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "csv-parse": "^7.0.2",
    "decimal.js": "^10.6.0",
    "next": "^15.5.25",
    "next-auth": "^4.24.15",
    "react": "^18",
    "react-dom": "^18",
    "recharts": "^2.12.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.4",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.4.19",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.25",
    "postcss": "^8.4.39",
    "prisma": "^5.20.0",
    "tailwindcss": "^3.4.6",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.1"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
